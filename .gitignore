# secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# deps / build
tools/scraperai/.venv/
__pycache__/
node_modules
.next/
dist/
build/
.vercel/

# os / editor noise
.DS_Store
*.log
tmp/

# codegraph local index (rebuilt per machine)
.codegraph/

# scratch
_probe_*

# the scheduled refresh holds this while it runs (scripts/refresh-sources.sh)
.refresh.lock
.refresh.lock.d/

# Scraped pages and harvest output — regenerate with the tools in
# tools/scraperai/.
#
# state.json was tracked at first, reasoning that a scheduled run needs the
# watermark to know where it got to. True, and beside the point: it holds one
# entry per scraped record, so moviemaps' alone is 91,919 lines, it is rewritten
# every run, and the branch had accumulated 128,003 lines of it. state.py's own
# docstring already said losing it "costs a full pass, not correctness" — a
# fresh machine does one ~2-hour crawl and is incremental forever after. Only
# summary.json stays, which is a few dozen lines a human actually reads.
tools/scraperai/.cache/
data/*/*.ndjson
data/*/state.json
# The discovery report is a measurement of a moment — wiki licences change and pages are
# rewritten. Regenerate it rather than reading a stale one out of the repo.
data/*/candidates.json

# Obsidian per-user state (shared config stays tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Graphify output (regenerated locally, optional)
graphify-out/

# operator handover notes — local only, not for the public/team repo
HANDOVER.md
.vercel

# A real Letterboxd export for local testing. Personal, and this repo is public.
public/demo-library.json
# Copied from the installed maplibre-gl by scripts/copy-maplibre-worker.mjs before dev and
# build, so the worker can never be a different version from the bundle that spawns it.
public/maplibre-gl-worker.mjs
public/maplibre-gl-shared.mjs

# pin audit: cache and full verdicts are regenerated by scripts/audit-place-pins.mjs
data/pin-audit/nominatim-cache.json
data/pin-audit/verdicts.json
