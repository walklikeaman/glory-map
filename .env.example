# Shared team test keys — scaffold.sh copies this file to app/.env.local.
# The Supabase URL + anon key are public by design (RLS protects the data) — they can live in the repo.
# NEVER put secrets here: the Supabase service_role key, the Vercel token, private API keys.

# Supabase — the team's shared "codex-hackathon" project (already created)
NEXT_PUBLIC_SUPABASE_URL=https://quvxxqxowathrcyshhwj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InF1dnh4cXhvd2F0aHJjeXNoaHdqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ1NjM2OTMsImV4cCI6MjEwMDEzOTY5M30.1_qVpOJ9ohil-qrkwHvWHTVPAlAwcZDJ3F96SlUFSQg

# OpenRouter — free models, and what the enrichment script uses when this is set.
# Takes precedence over OPENAI_API_KEY. Get a key at https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=sk-or-v1-YOUR-KEY
# Verified live: of the free models advertising structured outputs, this was the only
# one that returned valid JSON with every quote copied verbatim.
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
# Free endpoints share one bucket per account; 12/min leaves room for the app itself.
MODEL_REQUESTS_PER_MINUTE=12

# OpenAI — everyone uses their own key (the event provides $150 in API credits); fill it in on first use
OPENAI_API_KEY=sk-YOUR-KEY
OPENAI_MODEL=gpt-5-nano
# Optional override for web-assisted location research
OPENAI_SEARCH_MODEL=gpt-5-nano
# Optional override for location-to-scene visual matching
OPENAI_VISION_MODEL=gpt-5-nano
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# REQUIRED. Signs the scene-match request tokens stamped onto every film location.
# It used to fall back to OPENAI_API_KEY, which made rotating or removing that key
# silently invalidate every token already issued — a 403 on a page the user has open.
# Any long random value; generate with: openssl rand -base64 48
# SCENE_MATCH_SIGNING_SECRET=GENERATE-A-LONG-RANDOM-VALUE

# TMDB — server-only token for movie stills; add it to your local .env.local and the Vercel Environment Variables
# TMDB_API_READ_ACCESS_TOKEN=YOUR-TMDB-API-READ-ACCESS-TOKEN

# Server-only, do NOT commit: the Supabase service_role key (needed only for privileged operations)
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY  (get it from the Supabase dashboard, keep it out of the repo)

# Who may check readers' suggestions at /review (#48): emails of signed-in accounts, comma
# separated. Server-only. Unset means nobody: the review route answers 503, it does not open.
# It also needs SUPABASE_SERVICE_ROLE_KEY above.
# MODERATOR_EMAILS=you@example.com
# The AI pre-check (POST /api/review/suggestions/ai) needs no moderator: it uses ENRICH_TOKEN,
# SUPABASE_SERVICE_ROLE_KEY and a model key (OPENAI_API_KEY, or OPENROUTER_API_KEY).

# The basemap style provider. OPTIONAL: with no key the map draws OpenFreeMap's styles,
# which are free, need no signup and have no usage limit — so a fresh clone has a working
# map. Set this to switch to MapTiler's designed styles (#200).
#
# It is a PUBLIC key by design: it ships in the browser bundle, and MapTiler restricts it by
# domain in their own dashboard, which is where that restriction belongs. Get one free at
# https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=
